RewriteEngine On

# Keep API endpoints addressable as PHP scripts for JSON requests.
RewriteRule ^api/ - [L]

# Redirect browser page requests to extensionless URLs.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s(/[^?\s]+)\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ %{REQUEST_SCHEME}://%{HTTP_HOST}%1 [R=301,L,NE]

# Keep the admin user profile on its clean URL.
RewriteRule ^admin/user-profile/?$ admin/user-profile.php [L]

# Clean instructor module URLs: /add_module/{course_id} and /edit_module/{course_id}/{module_id}.
RewriteRule ^instructor/modules/add_module/([0-9]+)/?$ instructor/modules/add_module.php?id=$1 [L,QSA]
RewriteRule ^instructor/modules/edit_module/([0-9]+)/([0-9]+)/?$ instructor/modules/edit_module.php?course_id=$1&id=$2 [L,QSA]

# Resolve extensionless requests to their PHP page when no file or directory exists.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]